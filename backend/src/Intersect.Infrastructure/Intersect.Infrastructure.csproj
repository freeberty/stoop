<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Intersect.Infrastructure</RootNamespace>
    <AssemblyName>Intersect.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*" PrivateAssets="all" />
    <!-- Vetted secp256k1 library used for Nostr signature verification (BIP-340). -->
    <PackageReference Include="NBitcoin.Secp256k1" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Intersect.Application\Intersect.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sql\*.sql" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
