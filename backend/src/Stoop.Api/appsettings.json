{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "Persistence": { "Provider": "Postgres" },
  "Nostr": { "Verifier": "Library" },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=stoop;Username=stoop;Password=change-me"
  },
  "Auth": {
    "JwtSecret": "",
    "Issuer": "stoop",
    "Audience": "stoop-clients",
    "TokenLifetimeMinutes": 60,
    "ChallengeLifetimeSeconds": 120,
    "ExpectedDomain": "localhost",
    "ClockSkewSeconds": 120
  },
  "Chat": { "MaxMessageLength": 4000, "RateLimitMessages": 20, "RateLimitWindowSeconds": 10 },
  "Discovery": { "MaxFeatures": 2000 },
  "RateLimiting": { "PermitPerMinute": 240, "AuthPerMinute": 20 },
  "Cors": { "Origins": [] },
  "Seed": { "Enabled": false }
}
