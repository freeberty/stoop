# Copy to .env and fill in. Never commit .env.

# --- database
POSTGRES_DB=intersect
POSTGRES_USER=intersect
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- API
ASPNETCORE_ENVIRONMENT=Production
# Signs application tokens. At least 32 characters. Generate with:  openssl rand -base64 48
AUTH_JWT_SECRET=
# The domain Nostr signers must put in the login event's "domain" tag. Must match the web client origin's hostname.
AUTH_EXPECTED_DOMAIN=localhost
# Browser origin allowed by CORS
WEB_ORIGIN=http://localhost:5173
# Insert ~420 synthetic communities on first start when the database is empty
SEED_ENABLED=true
RATE_LIMIT_PER_MINUTE=600

# --- web client (build-time)
PUBLIC_API_URL=http://localhost:8080
# Any MapLibre-compatible style URL. OpenFreeMap needs no key. Swap for MapTiler/Mapbox/your own style.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- mobile (Flutter), passed with --dart-define
# MAPBOX_TOKEN=pk....   (public token for the Mapbox Maps SDK)
# API_URL=http://10.0.2.2:8080 (Android emulator -> host)
